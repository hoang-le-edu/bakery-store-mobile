<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Order Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order #123"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    tools:text="Order #12345" />

                <TextView
                    android:id="@+id/txtOrderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/11/2024 14:30"
                    android:textSize="@dimen/text_xs"
                    android:textColor="#757575"
                    android:layout_marginTop="@dimen/space_xs"
                    tools:text="15/11/2024 14:30" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_status_approval"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                tools:text="Pending" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="@dimen/space_md" />

        <!-- Receiver Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/space_sm">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_person"
                android:contentDescription="Person"
                app:tint="#757575" />

            <TextView
                android:id="@+id/txtReceiverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="@dimen/text_sm"
                android:textColor="#212121"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="John Doe" />

            <TextView
                android:id="@+id/txtReceiverPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0123456789"
                android:textSize="@dimen/text_sm"
                android:textColor="#757575"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="• 0123456789" />

        </LinearLayout>

        <!-- Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingBottom="@dimen/space_md">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Location"
                app:tint="#757575"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="123 Nguyen Hue, District 1, HCMC"
                android:textSize="13sp"
                android:textColor="#757575"
                android:layout_marginStart="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="123 Nguyen Hue, District 1, Ho Chi Minh City" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Order Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_payment"
                    android:contentDescription="Payment"
                    app:tint="#757575" />

                <TextView
                    android:id="@+id/txtPaymentMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COD"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginStart="6dp"
                    tools:text="COD" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total:"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginEnd="@dimen/space_sm" />

            <TextView
                android:id="@+id/txtTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150,000₫"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                android:textColor="@color/pink_primary"
                tools:text="150,000₫" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
