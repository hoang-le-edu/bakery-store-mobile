<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- For saving images on API <= 28 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheCodeCup"
        tools:targetApi="31">
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TheCodeCup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="MainActivity" />
        <activity android:name=".activity.Login" />
        <activity android:name=".activity.RegisterActivity" />
        <activity android:name=".activity.HomeActivity" />
        <activity android:name=".activity.ProductListActivity" />
        <activity android:name=".activity.ProductDetailActivity" />
        <activity android:name=".activity.AdminOrdersActivity" />
        <activity android:name=".activity.AdminHomeActivity" />
        <activity android:name=".activity.AdminProfileActivity" />
        <activity android:name=".activity.AdminOrderDetailActivity" />
        <activity android:name=".activity.AdminProductListActivity" />
        <activity android:name=".activity.AdminAddProductActivity" 
            android:parentActivityName=".activity.AdminProductListActivity"/>
        <activity android:name=".activity.AdminCustomerDetailActivity" />
        <activity android:name=".activity.CustomerDetailActivity" />
        <activity android:name=".activity.ProductReviewsActivity"/>



        <activity android:name=".activity.CartActivity" />
        <activity 
            android:name=".activity.CheckoutActivity"
            android:parentActivityName=".activity.CartActivity"
            android:theme="@style/Theme.TheCodeCup" />
        <activity 
            android:name=".activity.PaymentActivity"
            android:parentActivityName=".activity.CheckoutActivity"
            android:theme="@style/Theme.TheCodeCup" />
        <activity
            android:name=".activity.ProfileActivity"
            android:exported="false" />
            
        <activity
            android:name=".activity.MyOrdersActivity"
            android:parentActivityName=".activity.ProfileActivity"
            android:theme="@style/Theme.TheCodeCup" />
        
        <activity
            android:name=".activity.OrderDetailActivity"
            android:parentActivityName=".activity.MyOrdersActivity"
            android:theme="@style/Theme.TheCodeCup" />

        <activity
            android:name=".activity.MediaViewerActivity"
            android:parentActivityName=".activity.ProductReviewsActivity"
            android:theme="@style/Theme.TheCodeCup" />

